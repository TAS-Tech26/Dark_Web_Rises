# Base URL of the FastAPI game backend (no trailing slash).
# The WebSocket URL is derived from this automatically (http -> ws, https -> wss, + /ws).
# Leave empty to use the same origin as the frontend (when the API is reverse-proxied).
VITE_API_BASE_URL=http://localhost:8000
VITE_CTFD_URL=https://your-ctfd-instance.example.com
