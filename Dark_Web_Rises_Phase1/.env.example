# Copy this file to `.env` and fill in real values before deploying.
# .env itself is gitignored -- never commit real secrets.

# --- THE ONE THAT CATCHES EVERYONE -------------------------------------
# The address players' own devices use to reach this machine. Set it once
# here and docker-compose.yml derives all four of the places it is needed:
#
#   CORS_ALLOWED_ORIGINS   which origins the game API accepts
#   VITE_API_BASE_URL      where the frontend opens its websocket
#   VITE_CTFD_URL          where the results screen links for phase 2
#   PHASE2_CTFD_URL        the same link, sent from the backend
#
# It must NOT be localhost for a real event. This value is used by code
# running on a player's phone, and `localhost` there means *their phone*.
# Get the LAN address with `ipconfig` (IPv4 Address) and put it here.
#
# Leave it unset for solo local development and everything defaults to
# localhost, exactly as before.
#
# PUBLIC_HOST=192.168.1.50

# Comma-separated list of frontend origins allowed to call this API /
# open a websocket to it (CORS). Include every hostname the frontend is
# actually served from (Azure Static Web Apps URL, Krutrim Cloud URL,
# your own domain, local dev server, ...).
# "*" is rejected at startup: the API is served with credentials enabled,
# so a wildcard is both browser-invalid and unsafe.
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://your-frontend.example.com

# --- Docker stack wiring (docker-compose.yml) -------------------------
# Only used when running via `docker compose`. Ignored otherwise.

# Signs CTFd session cookies. Change before the event; rotating it logs
# everyone out mid-game.
CTFD_SECRET_KEY=change-me-before-the-event

# Phase 2's CTFd fork, built by the `ctfd` service. This is a FORK of CTFd
# 3.8.6 (modified scoreboard template + the challenge pages under
# CTFd/themes/core/static/), so it must be built from source -- the published
# ctfd/ctfd image does not contain any of it.
#
# Expected layout, with Phase 2 cloned as a sibling:
#
#   Dark_Web_Rises/
#     Dark_Web_Rises_Phase1/            <- you are here
#     DWR_Phase_2/
#       Dark_Web_Rises/                 <- the actual CTFd checkout
#
# Note the extra nesting level, and the capital P in DWR_Phase_2.
CTFD_SOURCE_DIR=../DWR_Phase_2/Dark_Web_Rises

# --- Image providers (services/providers.py) --------------------------
# Ordered failover chain. The first entry is the primary; each subsequent
# entry is tried only when the one before it fails or its circuit breaker
# is open. Reordering here promotes the backup with no code change.
#
# CHECK THIS BEFORE THE EVENT. A demo value here (pollinations / huggingface)
# is the single easiest way to arrive at event day with an unusable provider
# chain, because everything works fine in rehearsal -- that is what the demo
# providers are for. build_chain() logs a loud warning on every start when one
# is active; read the startup log rather than trusting this file.
#
# Decide the ordering from measurement, not from the default:
#   python tools/loadtest_deepinfra.py     # 700 images, one round's traffic
#   python tools/loadtest_replicate.py     # 400 images, ramped
#   python tools/loadtest_compare.py       # prints the IMAGE_PROVIDERS to use
IMAGE_PROVIDERS=deepinfra,replicate

DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=black-forest-labs/FLUX-2-klein-4b
# Image dimensions requested from DeepInfra. THIS IS A BILLING SETTING, not
# just a quality one: DeepInfra prices FLUX by area, not per image --
#
#     FLUX-2-klein-4b:  $0.014 x (width / 1024) x (height / 1024)
#
# and width/height default to 1024. The adapter used to send only the prompt,
# so every image was billed at the full 1024x1024 rate.
#
# Nothing downstream can see that resolution. CLIP RN50 preprocesses to
# 224x224 before it encodes, so everything above ~512 is paid for and then
# thrown away by the only component that reads these images.
#
#     1024x1024   $0.0140/image    ~$49 for a 3500-image event
#      512x512    $0.0035/image    ~$12 for the same event
#
# Set to 0 to omit width/height entirely and use the model's own defaults --
# only needed if DEEPINFRA_MODEL points at a model that rejects these fields
# (it answers HTTP 400, and the adapter now includes the body in the error).
DEEPINFRA_SIZE=512

REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Hugging Face -- DEMO AND TESTING ONLY, never the event.
# Serverless inference is rate limited (the limit is not published as a
# concurrency figure) and cold models return HTTP 503 "loading" on the first
# request after an idle period. Neither is survivable with 150 teams
# generating inside the same 90-second turn. Selecting it is deliberate:
# set IMAGE_PROVIDERS=huggingface. build_chain() then logs a loud warning on
# every start, so a demo configuration cannot quietly reach event day.
#
# Shape differs from the other two, per the published API spec:
#   request   the prompt field is `inputs`, not `prompt`
#   response  raw image bytes -- there is no JSON envelope
#
# The token must carry the "Inference Providers" permission. Create it at
# huggingface.co/settings/tokens -- a plain read token returns 403.
HF_TOKEN=
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Overridable because HF has already moved this route once
# (api-inference.huggingface.co -> router.huggingface.co).
HF_API_BASE=https://router.huggingface.co/hf-inference/models

# Pollinations -- DEMO AND TESTING ONLY, and the lowest-friction of the two:
# no key, no account, no credit, so there is nothing that can expire or run
# out mid-demo. Set IMAGE_PROVIDERS=pollinations to use it.
# A free public service with no contract and no concurrency guarantee, which
# is exactly why it is not an event provider.
# Shape: GET with the prompt in the URL path, raw image bytes back -- no POST
# body and no Authorization header, unlike every other adapter here.
POLLINATIONS_BASE=https://image.pollinations.ai/p
POLLINATIONS_MODEL=flux
# Scoring is CLIP RN50 at 224x224, so requesting more than ~512 spends
# latency and bytes on detail the scorer cannot resolve.
POLLINATIONS_SIZE=512

# Timeout budget. A turn is TIME_PER_ROUND seconds (90 in production), so
# one slow primary attempt plus a fast backup must fit comfortably inside
# it: 20 + 8 = 28s worst case. Do not raise these to the point where a
# single failover can consume a player's whole turn.
IMAGE_GEN_TIMEOUT_SECONDS=20
IMAGE_GEN_FALLBACK_TIMEOUT_SECONDS=8

# Circuit breaker: trip a provider after this many consecutive failures,
# then skip it entirely until the cooldown elapses and one probe succeeds.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30

# Operator kill switch. Set to a provider name to pin all traffic there
# during an incident, without a redeploy. Leave blank for normal operation.
IMAGE_PROVIDER_OVERRIDE=

# --- AI image generation (services/ai_handling.py) --------------------
# Sensible defaults are used if these are left unset.
#
# IMAGE_GEN_TIMEOUT_SECONDS is NOT repeated here. It used to be, set to 30,
# which silently won over the 20 set above -- dotenv takes the last
# assignment in the file -- quietly breaking the 20 + 8 = 28s budget that
# the comment above it documents. One variable, one definition.
#
# IMAGE_GEN_MAX_RETRIES and IMAGE_GEN_BACKOFF_SECONDS were also removed:
# nothing reads them any more. They belonged to the single-endpoint retry
# loop that was deleted when failover replaced it (three retries with
# backoff burned 60s+ of a 90s turn and could still return nothing).
# Rounds are synchronised, so all 175 teams request an image within the same
# second. This semaphore is what stands between that burst and the provider's
# rate limiter: at 40, the 175 requests are served in about five waves.
#
# The trade-off runs in both directions and neither end is free:
#   too high -> the whole burst lands at once and the provider sheds it (429),
#               and every shed request costs a player their turn
#   too low  -> the teams at the back of the queue wait through several waves
#               before their request even starts, inside a 90-second turn
#
# 40 is a reasonable starting point, not a measured one. Set it from the load
# test: run tools/loadtest_deepinfra.py, look at the concurrency at which the
# failure buckets start filling with rate_limit, and stay below it.
MAX_CONCURRENT_IMAGE_REQUESTS=40
MAX_PROMPT_LENGTH=300

# Hard cap on bytes accepted from the image API, so a malfunctioning or
# hostile upstream cannot OOM the single game process. Default 12 MiB.
MAX_IMAGE_BYTES=12582912

# How generated images reach players:
#   url    -- write to static/generated/ and send a short path (default;
#             strongly recommended at the ~1200-user target -- inlining
#             base64 ships 200-400 KB per player per turn through the
#             single event loop, several GB over a full event)
#   base64 -- inline the image in the websocket frame (legacy behaviour)
IMAGE_DELIVERY=url

# --- CLIP scoring pool -------------------------------------------------
# Threads used for the CPU-bound round-end image similarity scoring.
# Defaults to the machine's CPU count. Set TORCH_THREADS_PER_WORKER > 1
# only if CLIP_WORKER_THREADS is well below the core count, otherwise the
# two oversubscribe each other.
CLIP_WORKER_THREADS=0
TORCH_THREADS_PER_WORKER=1

# --- Websocket abuse limits (game.py) ---------------------------------
MAX_WS_FRAME_BYTES=65536
MAX_LOGIN_ATTEMPTS_PER_SOCKET=20
MIN_SECONDS_BETWEEN_LOGINS=0.5

# --- Roster ------------------------------------------------------------
# The roster is loaded from Supabase and cached locally, so a Supabase
# outage on the morning of the event cannot stop the app from booting.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key

# auto (default) | supabase | cache | hardcoded
#   auto      -- Supabase if both credentials above are set, else placeholders
#   cache     -- boot from the last cached roster without contacting Supabase
#   hardcoded -- built-in user1/password1 placeholders (local dev only)
ROSTER_SOURCE=auto

# Where the roster cache lives. Put it on a persistent volume alongside
# DWR_STATE_DIR so a restart can still boot if Supabase is unreachable.
# Contains attendee passwords in plain text -- it is gitignored and written
# owner-read-only. Treat it as you would the roster itself.
# ROSTER_CACHE_FILE=/home/data/roster_cache.json

# Event identifiers used to filter the Supabase query.
DWR_EVENT_NAME=Dark Web Rises
DWR_EVENT_SLUG=dark-web-rises

MAX_MEMBERS_PER_TEAM=4

# --- Roster size guard -------------------------------------------------
# How big this event is meant to be. game.py compares the roster it loaded
# against these at startup and REFUSES TO START if they disagree.
#
# The failure this prevents is silent and total. If Supabase is unreachable on
# the morning, roster.py falls back to the local cache -- which is correct, an
# outage must not stop the app booting. But the cache is a snapshot, and under
# Docker it is mounted read-only so the app can never refresh it. A stale
# 150-team cache with 175 teams in the room produces a completely clean
# startup: "Server ready: 600 players across 150 teams", green health check,
# no error anywhere. The only symptom is 100 attendees who cannot log in, and
# you find that out from the queue at the help desk.
#
# Leave these unset and the behaviour is exactly as before (no checking).
EXPECTED_TEAMS=175
EXPECTED_PLAYERS=700
# Set to false to downgrade the refusal to a logged error. Only do this if you
# have decided to run the event with a roster you know is short.
ROSTER_SIZE_STRICT=true

# Refresh the cache from the host before the event -- the container cannot:
#   python tools/roster_build.py refresh
#   python tools/roster_build.py check --expect-teams 175 --expect-players 700

# Admin accounts: "name:password,name2:password2".
# REQUIRED before a real event -- without it the app falls back to the
# placeholder admin credentials that are visible in the source.
# Where qualified teams are sent for phase 2, shown on the results screen.
# Must be reachable from the players' own devices -- use the host's LAN IP or
# a real hostname, not localhost, for anything but local testing.
PHASE2_CTFD_URL=http://localhost:8080

DWR_ADMINS=eventadmin:change-this-password

# Optional per-team display names, indexed from 0.
# TEAM_NAME_0=Red Team
# TEAM_NAME_1=Blue Team

# --- Persistence -------------------------------------------------------
# Directory for game_state.json. Point this at a persistent volume so a
# mid-event crash can be resumed. On Azure App Service only /home is
# durable across restarts -- the app directory is not.
# DWR_STATE_DIR=/home/data

# --- Game clock --------------------------------------------------------
# TIME_PER_ROUND is, despite the name, the budget for a single TURN. A round
# is MAX_MEMBERS_PER_TEAM turns, so at the defaults:
#
#     90s per turn x 4 turns = up to 360s per round
#     5 rounds + breaks      = up to ~31 minutes
#
# Turns end as soon as the player submits, so the real figure is lower -- but
# plan the schedule against the worst case. The app logs the derived number at
# startup so you do not have to do this arithmetic.
# TIME_PER_ROUND=90
# TOTAL_ROUNDS=5
#
# TURN_TIMEOUT is NOT in this list on purpose. It is passed all the way down
# to Team.run_round and then never read -- setting it changes nothing. If you
# were reaching for it to change how long a player gets, TIME_PER_ROUND is the
# one. game.py logs a warning if TURN_TIMEOUT is set, so this cannot be
# discovered the hard way twice.

# --- CTFd (docker-compose.yml) -----------------------------------------
# gunicorn workers for Phase 2. About half the field qualifies, so ~88 teams
# x 4 members = ~350 concurrent users. One worker does not fall over (gevent),
# but it serialises every flag check and scoreboard render onto one core.
# Requires SECRET_KEY and REDIS_URL, both of which the compose file sets.
CTFD_WORKERS=4

# --- Frontend (docker compose --profile dev) ---------------------------
# The player-facing frontend runs as a compose service behind the `dev`
# profile, so it starts only when asked for:
#
#   docker compose --profile dev up -d --build
#
# It runs `vite dev`. That is the right thing during setup and rehearsal and
# a questionable thing in front of 700 people: the dev server compiles
# modules on demand and serves them unbundled, which is hundreds of requests
# per page load plus a hot-reload websocket per client. Decide deliberately
# before event day rather than inheriting it.
#
# Its VITE_* variables come from PUBLIC_HOST above. Vite gives the process
# environment precedence over frontend-fusion/.env, so the compose values win
# and that file does not need editing.

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# NOTE: this file used to end with a note saying HF_TOKEN was read nowhere
# and that image generation went through the public Pollinations API. Both
# statements are now out of date: generation goes through the provider chain
# in services/providers.py, and HF_TOKEN is read by the demo-only Hugging
# Face provider documented above.
#
# The security half of that old note still stands, and harder than before:
# an HF_TOKEN was committed to this repository and remains in pushed git
# history. Removing it from .env did not unpublish it. Revoke it at
# https://huggingface.co/settings/tokens and issue a new one -- do not reuse
# the old value for the demo provider.
